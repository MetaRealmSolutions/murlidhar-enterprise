{
  "expo": {
    "name": "sales",
    "slug": "sales",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/icon.png",
    "scheme": "sales",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/branding/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/branding/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.murlidharenterprise.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/splash-icon.png",
          "imageWidth": 200
        }
      ],
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "878acb73-762e-43be-be60-c4e3cb4920d7"
      }
    }
  }
}
