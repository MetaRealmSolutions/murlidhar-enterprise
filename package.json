{
  "name": "murlidhar-enterprise",
  "main": "expo-router/entry",
  "electronMain": "electron/main.cjs",
  "version": "1.1.0",
  "releaseVersion": "1.1",
  "buildNumber": 2,
  "private": true,
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "electron-updater": "^6.8.9",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.19",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "firebase-admin": "^14.5.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "seed:users": "node --env-file-if-exists=.env.local scripts/seed-users.js",
    "seed:products": "node --env-file-if-exists=.env.local scripts/seed-products.js",
    "seed:ledger": "node --env-file-if-exists=.env.local scripts/seed-ledger.js",
    "reconcile:stock": "node --env-file-if-exists=.env.local scripts/reconcile-stock.js",
    "desktop:dev": "npx expo export --platform web && electron .",
    "desktop:build": "npx expo export --platform web && electron-builder --win nsis --x64 --publish never",
    "desktop:release": "npx expo export --platform web && electron-builder --win nsis --x64 --publish always",
    "typecheck": "tsc --noEmit"
  },
  "build": {
    "appId": "com.murlidharenterprise.desktop",
    "productName": "Murlidhar Enterprise",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "assets/branding/windows-icon.png",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.cjs"
    },
    "win": {
      "icon": "assets/branding/windows-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Murlidhar-Enterprise-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "MetaRealmSolutions",
      "repo": "murlidhar-enterprise",
      "releaseType": "release"
    }
  }
}
